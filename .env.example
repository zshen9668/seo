# ========== 登录（手机/电脑共用）==========
# 演示账号（邮箱登录）
AUTH_DEMO_EMAIL="admin@seopilot.local"
AUTH_DEMO_PASSWORD="admin123"

# 站点对外访问地址（OAuth 回调用，生产必填，例如 https://your-app.pages.dev）
APP_URL=""

# GitHub OAuth App（https://github.com/settings/developers）
# Authorization callback URL: {APP_URL}/api/auth/oauth/callback/github
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Google OAuth（Google Cloud Console → OAuth 客户端）
# 已授权的重定向 URI: {APP_URL}/api/auth/oauth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ========== 免费层优先（建议至少配置一个）==========
ZHIPU_API_KEY=""
SILICONFLOW_API_KEY=""
GEMINI_API_KEY=""
GROQ_API_KEY=""

# ========== 可选 / 按量付费 ==========
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
ANTHROPIC_API_KEY=""
DASHSCOPE_API_KEY=""
MOONSHOT_API_KEY=""
CUSTOM_LLM_BASE_URL="http://localhost:11434/v1"
CUSTOM_LLM_API_KEY=""
